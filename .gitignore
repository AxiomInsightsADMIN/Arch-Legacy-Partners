# Environments
.venv/
venv/
env/
.python-version

# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# CSV exports + drift report (large/transient, regenerable; do not commit
# by default — the monthly refresh workflow force-adds them on the dated
# refresh/YYYY-MM-DD branch for audit, but local runs leave them out).
exports/*.csv
exports/*.csv.gz
exports/*.parquet
exports/drift_report.json
!exports/.gitkeep

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Playwright artifacts
playwright-report/
test-results/
.playwright/

# Scratch / local-only
*.log
tmp/
scratch/
local/

# Claude Code session metadata (per-checkout, machine-local)
.claude/
